{
  "name": "@clockwork/root",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm --filter @clockwork/web exec next typegen && eslint . --max-warnings=0",
    "typecheck": "turbo run typecheck",
    "boundaries": "depcruise --config dependency-cruiser.config.mjs packages apps/web/src apps/web/app",
    "generate": "pnpm --filter @clockwork/api generate",
    "generate:baseline": "node scripts/generate-baseline-manifests.mjs",
    "check:generated": "pnpm generate && git diff --exit-code -- packages/api/src/generated",
    "check:traceability": "node scripts/validate-traceability.mjs",
    "scan:secrets": "secretlint \"**/*\" --secretlintrc .secretlintrc.json --secretlintignore .secretlintignore",
    "audit:dependencies": "pnpm audit --audit-level=high",
    "test": "turbo run test:unit test:integration",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:db": "pnpm db:test",
    "test:storybook": "pnpm --filter @clockwork/web test:storybook",
    "test:e2e": "pnpm --filter @clockwork/web test:e2e",
    "test:e2e:smoke": "pnpm --filter @clockwork/web test:e2e:smoke",
    "playwright:install": "pnpm --filter @clockwork/web exec playwright install chromium",
    "playwright:install:ci": "pnpm --filter @clockwork/web exec playwright install --with-deps chromium",
    "storybook": "pnpm --filter @clockwork/web storybook",
    "build:storybook": "pnpm --filter @clockwork/web build:storybook",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:diff": "supabase db diff --local",
    "db:test": "supabase test db",
    "prepare": "lefthook install",
    "verify:static": "turbo run typecheck format:check lint boundaries scan:secrets audit:dependencies && pnpm check:generated && pnpm check:traceability",
    "verify:database": "pnpm db:reset && pnpm db:test && pnpm test",
    "verify:build": "turbo run build build:storybook",
    "verify:ui": "turbo run test:storybook test:e2e",
    "verify": "pnpm verify:static && pnpm verify:database && pnpm verify:build && pnpm verify:ui"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.4",
    "@trigger.dev/sdk": "4.5.9",
    "@types/node": "24.13.3",
    "dependency-cruiser": "18.1.0",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "lefthook": "2.1.10",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "secretlint": "13.0.4",
    "supabase": "2.111.0",
    "tsx": "4.23.1",
    "turbo": "2.10.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.9",
      "engine.io@<6.6.7": "6.6.7",
      "postcss@<8.5.17": "8.5.25",
      "sharp@<0.35.0": "0.35.0",
      "ws@<8.21.0": "8.21.0"
    },
    "patchedDependencies": {
      "minimatch@3.1.5": "patches/minimatch@3.1.5.patch",
      "minimatch@5.1.9": "patches/minimatch@5.1.9.patch"
    }
  }
}
