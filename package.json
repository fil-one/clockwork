{
  "name": "@clockwork/root",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.15 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm --filter @clockwork/web exec next typegen && eslint . --max-warnings=0",
    "typecheck": "turbo run typecheck",
    "boundaries": "depcruise --config dependency-cruiser.config.mjs packages apps/web/src apps/web/app",
    "generate": "pnpm --filter @clockwork/api generate",
    "generate:baseline": "node scripts/generate-baseline-manifests.mjs",
    "check:generated": "pnpm generate && git diff --exit-code -- packages/api/src/generated",
    "check:traceability": "node scripts/validate-traceability.mjs",
    "check:schema-drift": "tsx scripts/check-schema-drift.mjs",
    "check:citation-liveness": "node scripts/check-citation-liveness.mjs",
    "scan:secrets": "secretlint \"**/*\" --secretlintrc .secretlintrc.json --secretlintignore .secretlintignore",
    "audit:dependencies": "pnpm audit --audit-level=high",
    "test": "turbo run test:unit test:integration",
    "test:unit": "turbo run test:unit && node --test scripts/release-artifacts.test.mjs scripts/benchmark-release.test.mjs scripts/dependency-advisories.test.mjs scripts/check-schema-drift.test.mjs scripts/validate-traceability.test.mjs scripts/check-citation-liveness.test.mjs scripts/run-db-tests.test.mjs scripts/secretlint-config.test.mjs scripts/check-demo-deploy-environment.test.mjs",
    "test:integration": "turbo run test:integration",
    "test:db": "pnpm db:test",
    "test:db:populated-upgrade": "node scripts/qualify-populated-upgrade.mjs",
    "test:storybook": "pnpm --filter @clockwork/web test:storybook",
    "test:e2e": "pnpm --filter @clockwork/web test:e2e",
    "test:e2e:smoke": "pnpm --filter @clockwork/web test:e2e:smoke",
    "playwright:install": "pnpm --filter @clockwork/web exec playwright install chromium",
    "playwright:install:ci": "pnpm --filter @clockwork/web exec playwright install --with-deps chromium",
    "storybook": "pnpm --filter @clockwork/web storybook",
    "build:storybook": "pnpm --filter @clockwork/web build:storybook",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:diff": "supabase db diff --local",
    "db:test": "node scripts/run-db-tests.mjs",
    "prepare": "lefthook install",
    "verify:static": "turbo run typecheck format:check lint boundaries scan:secrets audit:dependencies && pnpm check:generated && pnpm check:traceability && pnpm check:citation-liveness",
    "verify:database": "pnpm db:reset && pnpm check:schema-drift && pnpm db:test && pnpm test",
    "verify:build": "turbo run build build:storybook",
    "verify:ui": "turbo run test:storybook test:e2e",
    "release:parallel": "node scripts/release-suites.mjs --mode=parallel",
    "release:serial": "node scripts/release-suites.mjs --mode=serial",
    "release:debug": "node scripts/release-suites.mjs --mode=serial --debug",
    "release:plan": "node scripts/release-suites.mjs --mode=parallel --plan",
    "release:compare": "node scripts/compare-release-results.mjs",
    "release:benchmark": "node scripts/benchmark-release.mjs",
    "verify": "pnpm verify:static && pnpm verify:database && pnpm verify:build && pnpm verify:ui",
    "bootstrap:production": "tsx scripts/bootstrap-production.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@netlify/plugin-nextjs": "5.15.13",
    "@secretlint/secretlint-rule-pattern": "13.0.4",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.4",
    "@trigger.dev/sdk": "4.5.9",
    "@types/node": "24.13.3",
    "dependency-cruiser": "18.1.0",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "lefthook": "2.1.10",
    "netlify-cli": "27.1.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "secretlint": "13.0.4",
    "supabase": "2.111.0",
    "tsx": "4.23.1",
    "turbo": "2.10.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-jmr9-qjv8-65gv",
        "GHSA-7pqw-9j4j-h8q3"
      ]
    },
    "overrides": {
      "@esbuild-kit/core-utils@3.3.2>esbuild": "0.25.12",
      "netlify-cli@27.1.1>@opentelemetry/api": "1.8.0",
      "@trigger.dev/core@4.5.9>@opentelemetry/api-logs": "0.221.0",
      "@trigger.dev/core@4.5.9>@opentelemetry/core": "2.10.0",
      "@trigger.dev/core@4.5.9>@opentelemetry/exporter-logs-otlp-http": "0.221.0",
      "@trigger.dev/core@4.5.9>@opentelemetry/exporter-metrics-otlp-http": "0.221.0",
      "@trigger.dev/core@4.5.9>@opentelemetry/exporter-trace-otlp-http": "0.221.0",
      "@trigger.dev/core@4.5.9>@opentelemetry/instrumentation": "0.221.0",
      "@trigger.dev/core@4.5.9>@opentelemetry/resources": "2.10.0",
      "@trigger.dev/core@4.5.9>@opentelemetry/sdk-logs": "0.221.0",
      "@trigger.dev/core@4.5.9>@opentelemetry/sdk-metrics": "2.10.0",
      "@trigger.dev/core@4.5.9>@opentelemetry/sdk-trace-base": "2.10.0",
      "@trigger.dev/core@4.5.9>@opentelemetry/sdk-trace-node": "2.10.0",
      "brace-expansion": "5.0.9",
      "engine.io@<6.6.7": "6.6.7",
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<8.5.17": "8.5.25",
      "ws@<8.21.0": "8.21.0",
      "fast-uri@>=3 <3.1.6": "3.1.6",
      "fast-uri@>=4 <4.1.3": "4.1.3",
      "fastify@>=5 <5.12.1": "5.12.1",
      "qs@<6.16.0": "6.16.0",
      "toml@<4.2.0": "4.2.0",
      "js-yaml@<4.3.2": "4.3.2",
      "sharp@<0.35.4": "0.35.4",
      "image-size@<2.0.4": "2.0.4",
      "svgo@>=4 <4.1.0": "4.1.0"
    },
    "patchedDependencies": {
      "minimatch@3.1.5": "patches/minimatch@3.1.5.patch",
      "minimatch@5.1.9": "patches/minimatch@5.1.9.patch",
      "next@16.3.3": "patches/next@16.3.3.patch"
    }
  }
}
