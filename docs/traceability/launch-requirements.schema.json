{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clockwork.fil.one/schemas/launch-requirements.schema.json",
  "title": "Clockwork launch-requirement traceability ledger",
  "type": "object",
  "required": [
    "schemaVersion",
    "contract",
    "contractSha256",
    "statusPolicy",
    "requirements"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "type": "string", "const": "commerce_platform_spec.md" },
    "contractSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "statusPolicy": { "type": "object" },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requirement" }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "requirement",
        "domain",
        "api",
        "database",
        "workflowProvider",
        "portalDocument",
        "tests",
        "externalGates",
        "backlog",
        "status",
        "rationale"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^SPEC-[0-9A-Z-]+$" },
        "source": { "type": "string", "minLength": 1 },
        "requirement": { "type": "string", "minLength": 1 },
        "domain": { "$ref": "#/$defs/stringArray" },
        "api": { "$ref": "#/$defs/stringArray" },
        "database": { "$ref": "#/$defs/stringArray" },
        "workflowProvider": { "$ref": "#/$defs/stringArray" },
        "portalDocument": { "$ref": "#/$defs/stringArray" },
        "tests": { "$ref": "#/$defs/stringArray" },
        "externalGates": { "$ref": "#/$defs/stringArray" },
        "backlog": { "$ref": "#/$defs/stringArray" },
        "status": {
          "enum": [
            "implemented",
            "partial",
            "unimplemented",
            "external-gated",
            "historical"
          ]
        },
        "rationale": { "type": "string", "minLength": 1 }
      }
    }
  }
}
