{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["CLOCKWORK_NEXT_STANDALONE"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test:unit": {
      "outputs": []
    },
    "test:integration": {
      "passThroughEnv": [
        "CLOCKWORK_SERVICE_DATABASE_URL",
        "DATABASE_URL",
        "DIRECT_DATABASE_URL"
      ],
      "outputs": [],
      "cache": false
    },
    "//#format:check": {
      "outputs": []
    },
    "//#lint": {
      "outputs": []
    },
    "//#boundaries": {
      "outputs": []
    },
    "//#scan:secrets": {
      "outputs": []
    },
    "//#audit:dependencies": {
      "cache": false,
      "outputs": []
    },
    "//#build:storybook": {
      "outputs": ["apps/web/storybook-static/**"]
    },
    "//#test:storybook": {
      "outputs": []
    },
    "//#test:e2e": {
      "cache": false,
      "outputs": ["apps/web/playwright-report/**", "apps/web/test-results/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
