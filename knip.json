{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  // Poppler tools the document integration tests call when installed.
  "ignoreBinaries": ["pdffonts", "pdftotext"],
  "ignore": [
    // Operator command run with tsx by scripts/release-artifacts.mjs and scripts/verify-demo-reset-safety.mjs.
    "packages/testing/src/demo/reset-command.ts",
    // MNDA lane file awaiting its staff-home caller; owned outside this config.
    "apps/web/src/features/internal-ops/mnda/summary.ts",
    // Generated by `pnpm generate`; its unused types mirror the OpenAPI document.
    "packages/api/src/generated/**"
  ],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.{mjs,ts}", "trigger.config.ts", "*.config.{mjs,ts}"],
      "project": ["scripts/**/*.{mjs,ts}", "*.{mjs,ts}"],
      "ignoreDependencies": [
        // Loaded by name from .secretlintrc.json.
        "@secretlint/secretlint-rule-pattern",
        "@secretlint/secretlint-rule-preset-recommend",
        // Bundles the production scripts in the Dockerfile.
        "esbuild",
        // Deploys the hosted demo (docs/operations/demo-deploy.md).
        "netlify-cli"
      ]
    },
    "apps/web": {
      "entry": [
        "app/**/*.{ts,tsx}",
        "e2e/**/*.{ts,mjs}",
        "playwright*.config.ts",
        "src/storybook/**/*.{ts,tsx}"
      ],
      "project": ["**/*.{ts,tsx,mjs}"],
      // The proof and hosted-demo configs throw without release secrets, so
      // the configs and e2e/ are listed as entries instead of loaded.
      "playwright": false,
      "ignoreDependencies": [
        // Next's runtime helpers, pinned for clean installs (797a077).
        "@swc/helpers",
        // Imported from CSS, which knip does not read.
        "tailwindcss"
      ]
    },
    "apps/showcase": {
      "entry": ["app/**/*.{ts,tsx}", "tests/**/*.ts"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/*": {
      "includeEntryExports": true,
      "entry": ["src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/db": {
      "includeEntryExports": true,
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      // drizzle.config.ts throws without a migration URL; drizzle-kit is kept deliberately.
      "drizzle": false,
      "ignoreDependencies": ["drizzle-kit"]
    },
    "packages/testing": {
      "includeEntryExports": true,
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/workflows": {
      "includeEntryExports": true,
      "entry": ["src/trigger/**/*.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/ui": {
      "includeEntryExports": true,
      "entry": ["src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
