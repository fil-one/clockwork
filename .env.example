NODE_ENV=development
CLOCKWORK_ENV=development
CI=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
CLOCKWORK_CANONICAL_ORIGIN=http://localhost:3000
NEXT_PUBLIC_CLOCKWORK_RUNTIME_ENV=development
# Optional public release SHA used only as a telemetry correlation dimension.
NEXT_PUBLIC_CLOCKWORK_RELEASE_SHA=
# Internal build-isolation override; normal builds retain Next.js' .next directory.
CLOCKWORK_NEXT_DIST_DIR=.next
CLOCKWORK_EXPERIENCE_ADAPTER=database
CLOCKWORK_DEMO_STATE_PATH=
# Deliberate demo-deploy opt-in: "1" tells the demo guards that a production
# NODE_ENV came from `next build`, not from a production environment. Never set
# it on a real production site; every other production marker still refuses.
CLOCKWORK_DEMO_DEPLOY=
# Password in front of a demo deploy. Setting it alongside the opt-in above
# turns on the gate; leaving it empty means no gate exists at all.
CLOCKWORK_DEMO_ACCESS_PASSWORD=
CLOCKWORK_EVIDENCE_ADAPTER=http
DATABASE_URL=
CLOCKWORK_SERVICE_DATABASE_URL=
DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?sslmode=disable
AUTHORIZATION_CONTEXT_SECRET=clockwork-local-auth-context-secret-change-me
AUTHORIZATION_CONTEXT_SECRET_ID=local
CLOCKWORK_RUNTIME_DATABASE_PASSWORD=
CLOCKWORK_SERVICE_DATABASE_PASSWORD=
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
WORKOS_WEBHOOK_SECRET=
WORKOS_MFA_POLICY_ORGANIZATION_IDS=
INTERNAL_EMAIL_DOMAINS=filone.com
CLOCKWORK_ENABLE_SIMULATORS=false
# Qualification-only proof mode. Production configuration must never default it on.
CLOCKWORK_RELEASE_PROOF=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ESIGN_WEBHOOK_SECRET=
ESIGN_API_BASE_URL=
ESIGN_API_KEY=
ESIGN_SIGNING_ORIGINS=https://esign.clockwork.test
ESIGN_RETURN_ORIGINS=http://localhost:3000
NEXT_PUBLIC_ESIGN_SIGNING_ORIGINS=https://esign.clockwork.test
PROVISIONING_WEBHOOK_SECRET=
# One signing secret per marketplace. There is deliberately no shared fallback:
# a marketplace with no secret set has its webhooks denied, because a shared key
# would let any one marketplace integration sign for another's resources.
MARKETPLACE_WEBHOOK_SECRET_AWS=
MARKETPLACE_WEBHOOK_SECRET_AZURE=
MARKETPLACE_WEBHOOK_SECRET_GOOGLE=
# Comma-separated support providers, each with its own secret under
# SUPPORT_WEBHOOK_SECRET_<PROVIDER> (uppercased, hyphens become underscores).
SUPPORT_PROVIDERS=
SUPPORT_WEBHOOK_SECRET_ZENDESK=
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=
WORKFLOW_PROVIDER_CONTROL_BASE_URL=
WORKFLOW_PROVIDER_CONTROL_TOKEN=
ACCOUNTING_PROVIDER_BASE_URL=
ACCOUNTING_PROVIDER_TOKEN=
NOTIFICATION_PROVIDER_BASE_URL=
NOTIFICATION_PROVIDER_TOKEN=
USAGE_PROVIDER_BASE_URL=
USAGE_PROVIDER_TOKEN=
PROVISIONING_PROVIDER_BASE_URL=
PROVISIONING_PROVIDER_TOKEN=
SCREENING_PROVIDER_BASE_URL=
SCREENING_PROVIDER_TOKEN=
# EXT-TAX-01. The platform never decides a tax treatment for itself, so with
# these unset the tax port refuses every determination and the two commands that
# ask it for one -- orders:create (quote acceptance) and invoices:create --
# refuse rather than issuing a zero-tax document. Every other Core finance
# command is unaffected.
TAX_PROVIDER_BASE_URL=
TAX_PROVIDER_TOKEN=
SIGNATURE_PROVIDER_BASE_URL=
SIGNATURE_PROVIDER_TOKEN=
SIGNATURE_PROVIDER_SIGNING_ORIGINS_JSON=[]
EVIDENCE_PROVIDER_BASE_URL=
EVIDENCE_PROVIDER_TOKEN=
EVIDENCE_STORAGE_INTERNAL_URL=
EVIDENCE_STORAGE_INTERNAL_TOKEN=
EVIDENCE_CLIENT_ORIGINS=http://localhost:3000
DOCUMENT_RENDERER_PROVIDER_BASE_URL=
DOCUMENT_RENDERER_PROVIDER_TOKEN=
WORKOS_MFA_PROVIDER_BASE_URL=
WORKOS_MFA_PROVIDER_TOKEN=
PLATFORM_ISSUER_JSON=
EVIDENCE_BUCKET=
EVIDENCE_AWS_REGION=us-east-1
EVIDENCE_AWS_ACCOUNT_ID=
CLICK_THROUGH_THRESHOLD_MINOR=
MIGRATION_FEATURE_ENABLED=false
MIGRATION_SOURCE_BASE_URL=
MIGRATION_SOURCE_TOKEN=
MIGRATION_SOURCE_WINDOW_ID=
MIGRATION_SOURCE_AUTHORIZED_ACTOR_ID=
MIGRATION_SOURCE_ACCESS_EVIDENCE_HASH=
MIGRATION_SOURCE_EXECUTION_ENABLED=false
MIGRATION_SOURCE_MAX_BYTES=750000
MIGRATION_SOURCE_MAX_RECORDS=10000
AUTOMATED_TEARDOWN_ENABLED=false
WEBHOOK_MAX_BODY_BYTES=1048576
CLOCKWORK_TRUSTED_PROXY_HOPS=0
OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=clockwork-runtime
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional signal-specific hosted trace endpoint override.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_RESOURCE_ATTRIBUTES=service.namespace=clockwork,deployment.environment.name=development
# Signs the short-lived browser telemetry ingest grant. Must be a server-only
# secret of at least 32 bytes and must never be a value handed to a visitor.
# Falls back to WORKOS_COOKIE_PASSWORD, then CLOCKWORK_PROOF_AUTH_SECRET; a
# deployment with none of the three mints no grant and ingests no browser
# telemetry, which is the intended fail-closed outcome rather than a fault.
CLOCKWORK_TELEMETRY_INGEST_SECRET=
