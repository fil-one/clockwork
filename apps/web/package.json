{
  "name": "@clockwork/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "clean": "rm -rf .next coverage playwright-report storybook-static test-results",
    "dev": "next dev",
    "start": "next start",
    "typecheck": "next typegen && tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests --config vitest.integration.config.ts",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:proof": "playwright test --config playwright.proof.config.ts"
  },
  "dependencies": {
    "@clockwork/api": "workspace:*",
    "@clockwork/contracts": "workspace:*",
    "@clockwork/db": "workspace:*",
    "@clockwork/documents": "workspace:*",
    "@clockwork/integrations": "workspace:*",
    "@clockwork/testing": "workspace:*",
    "@clockwork/ui": "workspace:*",
    "@clockwork/workflows": "workspace:*",
    "@swc/helpers": "0.5.15",
    "@workos-inc/authkit-nextjs": "catalog:",
    "@workos-inc/node": "catalog:",
    "hono": "catalog:",
    "drizzle-orm": "catalog:",
    "next": "16.2.12",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.5",
    "@storybook/addon-docs": "10.5.5",
    "@storybook/addon-vitest": "10.5.5",
    "@storybook/nextjs-vite": "10.5.5",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "6.0.5",
    "axe-core": "4.12.1",
    "jsdom": "30.0.1",
    "postcss": "8.5.25",
    "storybook": "10.5.5",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
