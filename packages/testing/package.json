{
  "name": "@clockwork/testing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./demo-reset": "./src/demo/reset.ts",
    "./demo-state": "./src/demo/state.ts",
    "./playwright": "./src/playwright/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@clockwork/api": "workspace:*",
    "@clockwork/contracts": "workspace:*",
    "@clockwork/db": "workspace:*",
    "@clockwork/domain": "workspace:*",
    "@clockwork/integrations": "workspace:*",
    "@clockwork/workflows": "workspace:*",
    "@faker-js/faker": "catalog:",
    "@playwright/test": "1.62.1",
    "fast-check": "catalog:",
    "msw": "catalog:",
    "postgres": "catalog:",
    "stripe": "catalog:",
    "vitest": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
