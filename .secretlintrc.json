{
  "rules": [
    { "id": "@secretlint/secretlint-rule-preset-recommend" },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "Netlify access token assignment",
            "patterns": [
              "/NETLIFY_AUTH_TOKEN\\s*=\\s*(?<netlify_token>[A-Za-z0-9_-]{30,})\\b/g",
              "/\\b(?<netlify_personal_access_token>nfp_[A-Za-z0-9_-]{20,})\\b/g"
            ]
          }
        ]
      }
    }
  ]
}
